{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "awesomemovie": "Debug",
        "System": "Warning",
        "Microsoft.Hosting.Diagnostics": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "ConnectionStrings": {
    // Local:
    //"DefaultConnection": "Host=localhost;Port=5432;Username=postgres;Password=123456789;Database=Noah.app;Pooling=false;Timeout=300;CommandTimeout=300;"

    // Produção (configure via env var ConnectionStrings__DefaultConnection):
    "DefaultConnection": ""
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "your_secret_key_here_your_secret_key_here",
    "Issuer": "your_issuer",
    "Audience": "your_audience"
  },
  "AutoNotifications": {
    "Reminder30Min": {
      "Enabled": true
    },
    "Cleanup": {
      "Enabled": true,
      "RunAtLocalHour": 3,
      "RunAtLocalMinute": 0,
      "ReminderNotificationsRetentionDays": 7,
      "DispatchRetentionDays": 30
    }
  },
  "WebPush": {
    "Subject": "mailto:admin@maidsflow.com",
    "PublicKey": "CHANGE_ME_VAPID_PUBLIC_KEY",
    "PrivateKey": "CHANGE_ME_VAPID_PRIVATE_KEY"
  },
  "S3": {
    "BucketName": "maidsflowbucketchecklist",
    "Region": "us-east-1",
    "ChecklistPrefix": "Checklists/",
    "UploadUrlExpiresMinutes": 10,
    "DownloadUrlExpiresMinutes": 60
  },
  "Twilio": {
    "AccountSid": "",
    "AuthToken": "",
    "FromNumber": ""
  },
  "SendGrid": {
    "ApiKey": "",
    "ApiBaseUrl": "https://api.sendgrid.com",
    "FromEmail": "",
    "FromName": "MaidsFlow",
    "SupportUrl": "https://maidsflow.com",
    "CredentialsSubject": "Your MaidsFlow access credentials"
  }
}
test

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "AccessTokenMinutes": 43200,
    "RefreshTokenDays": 30,
    "RememberMeRefreshDays": 30,
    "Issuer": "your_issuer",
    "Audience": "your_audience",
    "Key": "CHANGE_ME_SUPER_SECRET_KEY",
    "AccessTokenDays": 30
  },
  "AutoReviews": {
    "ReviewRequestAfterComplete": {
      "Enabled": true,
      "DelayMinutes": 30,
      "LookbackDays": 14,
      "BatchSize": 50,
      "LoopSeconds": 60,
      "RetryEveryMinutes": 10,
      "MaxAttempts": 6,
      "PublicReviewFormBaseUrl": "https://maidsflow.com/review"
    }
  },
  "SendGrid": {
    "ApiKey": "",
    "ApiBaseUrl": "https://api.sendgrid.com",
    "FromEmail": "",
    "FromName": "MaidsFlow",
    "SupportUrl": "https://maidsflow.com",
    "CredentialsSubject": "Your MaidsFlow access credentials",
    "PasswordChangedSubject": "Your MaidsFlow password was changed",
    "PlanPaymentSuccessSubject": "Payment successful",
    "PublicReviewFormBaseUrl": "https://maidsflow.com/review",
    "ReviewRequestSubject": "How was your service?",
    "DisableClickTracking": true
  },
  "GpsTracking": {
    "IngestApiKey": "",
    "EnableReverseGeocoding": true
  },
  "GoogleMaps": {
    "ApiKey": ""
  },
  "Auth": {
    "Google": {
      "ClientId": "792889776714-nnbjgh6m2372m1o7u8m008r1f62415ou.apps.googleusercontent.com"
    }
  },
  "AutomationAlerts": {
    "Enabled": true,
    "DefaultRecipientEmail": "bruno@maidsflow.com",
    "DefaultRecipientName": "Bruno",
    "SubjectPrefix": "[MaidsFlow Automation Failure]",
    "WebhookSecret": "CHANGE_ME_AUTOMATION_ALERT_SECRET"
  }
  ,"Reports": {
    "MonthlyEmail": {
      "Enabled": true,
      "RunOnDayOfMonth": 1,
      "RunHourUtc": 8,
      "PollIntervalMinutes": 60,
      "TriggeredByValue": "system-monthly"
    }
  }
}
